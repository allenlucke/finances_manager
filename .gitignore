node_modules/
services/web/dist/
services/web/.angular/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# --- Editors / OS ---
.idea/
.DS_Store
*.iml
