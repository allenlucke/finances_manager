# Overrides for the throwaway e2e compose project. Layered on top of .env by the Makefile, so
# only the things that must differ live here. Committed on purpose: nothing in it is a secret.
LOCAL_API_TOKEN=
DATABASE_PASSWORD=e2e-throwaway
# Keys the scratch stack's account ids. A fixed value, so the suite's links are the same on every
# run and this file stays free of anything generated; the database it keys is truncated every run.
ACCOUNT_KEY_SECRET=e2e-throwaway-account-key-secret
# Deterministic quotes, labelled fake, and no background poll racing the browser suite.
MARKET_DATA_PROVIDER=fake
MARKET_REFRESH_SCHEDULED=false
# The e2e web container is published on 4201 and its API on 8081. A passkey ceremony from that
# origin is refused by an API that only allows the dev ports, so the browser suite could never
# exercise passkeys until these matched.
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:4201,http://localhost:8081
