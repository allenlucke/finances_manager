# Copy to .env and adjust. .env is gitignored and must never be committed.
# See docs/SECURITY.md — this file grows to hold real credentials, so treat it accordingly.

# --- Database ---
DATABASE_NAME=finances
DATABASE_USER=finances
DATABASE_PASSWORD=change-me-locally
DATABASE_PORT=5432

# --- Ports ---
API_PORT=8080
WEB_PORT=4200

# --- Logging ---
LOG_LEVEL=INFO

# --- Local automation token (D-17) ---
# Lets the MCP server in services/mcp — and therefore Claude Code — act as the account owner
# without a browser session. Generate it with `make mcp-token`, which writes it here for you.
#
# Leave it blank and the feature is off: the API only installs the token filter when a value is
# set. It is refused on anything but a loopback connection, and it satisfies the passkey second
# factor, which is the sharp edge — read docs/SECURITY.md before setting it on any host that is
# not this laptop.
LOCAL_API_TOKEN=

# --- AI / inference (not wired up until M3; see docs/DECISIONS.md D-15) ---
# Choose hosted or local inference deliberately. Sending full statements to a third party
# is a real decision — document it in docs/SECURITY.md when it is made.
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# --- Aggregator (not wired up until M5; see docs/DECISIONS.md D-14) ---
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
