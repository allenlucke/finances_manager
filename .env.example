# Copy to .env and adjust. .env is gitignored and must never be committed.
# See docs/SECURITY.md — this file grows to hold real credentials, so treat it accordingly.

# --- Database ---
DATABASE_NAME=finances
DATABASE_USER=finances
DATABASE_PASSWORD=change-me-locally
DATABASE_PORT=5432

# --- Ports and reachability ---
API_PORT=8080
WEB_PORT=4200
# Where Docker publishes the ports. Loopback means only this machine. On the homelab (D-16) set
# this to the box's Tailscale address (100.x.y.z) and nothing else — never 0.0.0.0. Whatever you
# put here is also exactly how far LOCAL_API_TOKEN can reach; see below.
BIND_ADDR=127.0.0.1

# --- Logging ---
LOG_LEVEL=INFO

# --- Backups (docs/RUNBOOK.md) ---
# The key `make backup` encrypts archives with. Kept OUTSIDE the repository on purpose, and copied
# into a password manager: without it an archive is noise. `make backup-key` creates it.
BACKUP_KEY_FILE=~/.config/finances/backup.key
# Where finished archives are copied — a mounted external drive, a synced folder, a NAS path.
# Blank means the archive stays on this disk, and `make backup` says so every time.
BACKUP_COPY_TO=

# --- Market data and alerts (M7, docs/DECISIONS.md D-18) ---
# Which market-data vendor the AI service asks for quotes. `none` means the Markets screen says
# market data is off. `alpaca`: a free Alpaca account gives the IEX feed and paper trading in one
# signup — put its keys below; they live in the AI container only. `fake` is for a stack with no
# vendor: deterministic prices, labelled fake everywhere they appear.
MARKET_DATA_PROVIDER=none
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Where a fired price alert is pushed: an ntfy topic URL (https://ntfy.sh/<a-long-random-topic>, or a
# self-hosted ntfy reachable over Tailscale). Blank records firings without sending them anywhere.
NTFY_URL=
# How often the API polls for quotes and evaluates alerts. ISO-8601 duration.
MARKET_REFRESH_EVERY=PT5M

# --- Orders (M7b, docs/DECISIONS.md D-18) ---
# The broker the AI service sends confirmed orders to. `alpaca_paper` uses the same Alpaca keys as
# the market data and only ever the paper endpoint; live trading is not a configuration option in
# this release. `fake` fills everything, for a stack with no broker.
TRADING_BROKER=none
# The kill switch. Off means a confirmed paper order is refused with a sentence naming this.
TRADING_ENABLED=false
# The most a day's confirmed paper orders may add up to, in dollars.
TRADING_DAILY_CAP=1000.00

# --- Strategies (M7c, docs/DECISIONS.md D-19) ---
# How often an active strategy is asked for its opinion, when MARKET_REFRESH_SCHEDULED is on.
# A signal becomes a draft order for you to confirm; a strategy never trades by itself.
STRATEGY_EVALUATE_EVERY=PT1M

# --- The daily digest (M8, docs/DECISIONS.md D-20) ---
# Once a day, at the time set in the app (07:30 by default, in APP_TIMEZONE), the API pushes what
# needs a look to NTFY_URL: mismatched statements, orders waiting on you, reminders coming due,
# categories over target, accounts nobody has imported for a while. false turns the push off; the
# dashboard card shows the same list regardless.
DIGEST_SCHEDULED=true

# --- Time zone ---
# Where "today" and "this month" are decided when the API has to decide them itself (the MCP tools'
# default ranges, a target with no start date). The browser sends its own dates. Containers run in
# UTC, where a Kansas evening on the 31st is already next month.
APP_TIMEZONE=America/Chicago

# --- Account key secret ---
# Keys the one-way ids the importer links rows to accounts by (docs/SECURITY.md → Data handling).
# `make up` generates one into this file when it is blank; you never need to know its value.
# It has to stay the same for the life of the database — back it up with the database — because
# an account linked under one secret is not found under another.
ACCOUNT_KEY_SECRET=

# --- Local automation token (D-17) ---
# Lets the MCP server in services/mcp — and therefore Claude Code — act as the account owner
# without a browser session. Generate it with `make mcp-token`, which writes it here for you.
#
# Leave it blank and the feature is off: the API only installs the token filter when a value is
# set. It satisfies the passkey second factor, which is the sharp edge — read docs/SECURITY.md
# before setting it on any host that is not this laptop.
LOCAL_API_TOKEN=
# Whether the API itself refuses the token from non-loopback connections. Compose sets this to
# false because Docker rewrites the source address and the check cannot work inside a container;
# there, BIND_ADDR above is the whole boundary. Running the API natively, leave it true.
LOCAL_API_TOKEN_LOOPBACK_ONLY=true
# Where the MCP server finds the API. Defaults to http://localhost:8080; set it here if API_PORT
# above changes, since .mcp.json no longer hardcodes it (an entry there could never be overridden).
# API_URL=http://localhost:8080

# --- AI / inference (not wired up until M3; see docs/DECISIONS.md D-15) ---
# Choose hosted or local inference deliberately. Sending full statements to a third party
# is a real decision — document it in docs/SECURITY.md when it is made.
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# --- Aggregator (not wired up until M5; see docs/DECISIONS.md D-14) ---
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox

# Passkeys are bound to the browser's origin. Leave these alone for local dev; on any other host
# set the registrable domain and the full origins the app is served from (docs/SECURITY.md, D-16).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080
# Set to true the day the app sits behind TLS. Over plain HTTP a Secure cookie is never sent.
COOKIE_SECURE=false
